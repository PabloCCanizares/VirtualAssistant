FLASK_ENV=
FLASK_DEBUG=
FLASK_SECRET_KEY=
LOG_LEVEL=
TZ=

# User identity
APP_USER_NICKNAME=
DEFAULT_USER_ID=

# --------------------------------------
# AI / LangGraph API keys and model names
# --------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# -----------------------------
# MongoDB connection settings
# -----------------------------
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017
MONGO_LOCAL_DB=VirtualAssistantDB

# Conexión remota (Atlas)
MONGO_REMOTE_URI=
MONGO_REMOTE_DB=VirtualAssistantDB

MAX_CONTENT_LENGTH_MB=25
UPLOAD_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,png,jpg,jpeg,csv,xlsx,pptx,zip